# Local, untracked provider settings for `compose.provider.yml`.
#
#   copy .env.provider.example .env.provider.local     # then fill in the three values
#
# .env.provider.local is ignored by this repository's `*.local` rule, so what is typed here
# never reaches a commit, an image layer, or `docker compose config` output. The default
# stack does not read this file at all: without compose.provider.yml the backend answers
# from `echo` with the scripted quiz model and needs no credential.
#
# Only the backend container reads it (compose.provider.yml lists it under the backend's
# env_file), and it never overrides the database credentials - those stay in
# .env.compose.local. Because env_file values are *set* rather than merged, leaving a key
# blank here is the same as not supplying it: the backend then names the missing variable
# and stops, which is the intended answer to a half-filled provider configuration.
#
# These three are required in provider mode. The backend refuses to start on any one of them
# missing (openai: GOPHERLEARN_OPENAI_BASE_URL / _API_KEY / _MODEL is required), and it
# never falls back to `echo` to keep the container up.

# A base URL ending in /v1 is not required - this server appends its own path - and it must
# carry no embedded credentials: a URL like https://user:pass@host is refused at startup.
GOPHERLEARN_OPENAI_BASE_URL=

GOPHERLEARN_OPENAI_API_KEY=

GOPHERLEARN_OPENAI_MODEL=

# Optional, and each one is validated when present rather than repaired: a bad value stops
# startup instead of being clamped into something plausible. An unset GOPHERLEARN_AI_PROVIDER
# here is normal - compose.provider.yml is what names the provider, so the mode is visible in
# a tracked file rather than hidden in a local one.

# 0 to 2. Blank means the provider's own default.
GOPHERLEARN_OPENAI_TEMPERATURE=

# Positive integer; blank means the built-in ceiling.
GOPHERLEARN_OPENAI_MAX_OUTPUT_TOKENS=

# A Go duration such as 45s or 2m; blank means the built-in default.
GOPHERLEARN_OPENAI_TIMEOUT=

# true or false only.
GOPHERLEARN_OPENAI_ENABLE_THINKING=
