# Copy to .env.mysql.local and replace every value with a generated one.
# .env.mysql.local is not committed (the repo's *.local rule covers it), and this
# file carries placeholders only - nothing here is a working credential.
#
# Generate real values rather than inventing them:
#
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
#
# MYSQL_DATABASE and MYSQL_USER name the application schema and its user; the
# official image creates the user with full rights on that schema only. The two
# passwords are separate on purpose: the root account is not what the backend
# connects as, and it is never used by the application at runtime.
MYSQL_DATABASE=gopherlearn
MYSQL_USER=gopherlearn
MYSQL_PASSWORD=replace-me-with-a-generated-32-char-value
MYSQL_ROOT_PASSWORD=replace-me-with-a-different-generated-32-char-value
