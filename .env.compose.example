# Copy to .env.compose.local (not committed: the repo's *.local rule covers it) and
# replace every value. This one file feeds both containers - MySQL through its env_file,
# the backend through its own - so a password exists in exactly one place.
#
# Generate rather than invent:
#
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
#
# The three secrets must differ from each other: the database superuser password, the
# application database password, and the token-signing secret. Nothing here is a working
# credential.

# Marker only. compose.app.yml interpolates it with ${VAR:?}, so a stack run against a
# missing or wrong env file stops with a named complaint instead of starting half-configured.
GOPHERLEARN_COMPOSE_PROFILE=local-8c

# Read by the MySQL container itself (official image variable names).
MYSQL_DATABASE=gopherlearn
MYSQL_USER=gopherlearn
MYSQL_PASSWORD=replace-me-with-a-generated-32-char-value
MYSQL_ROOT_PASSWORD=replace-me-with-a-different-generated-32-char-value

# The backend dials MySQL over the compose network, so the host is the service name and
# the port is the container port - not the loopback 127.0.0.1:3308 the standalone
# single-MySQL flow uses.
GOPHERLEARN_MYSQL_DSN=gopherlearn:replace-me-with-the-same-app-password@tcp(mysql:3306)/gopherlearn

# Token signing key. Rotating it invalidates every issued token but leaves stored rows
# alone, which is what a restart during acceptance testing looks like.
GOPHERLEARN_JWT_SECRET=replace-me-with-a-third-generated-value

# Optional, and only for a network that cannot reach Docker Hub: the three build-stage base
# images can be repointed at a mirror. Leave them unset for a normal build - the Dockerfiles
# and compose.app.yml default to golang:1.24.10-bookworm, node:22-bookworm-slim and
# nginx:1.27-alpine.
# GOPHERLEARN_GO_IMAGE=mirror.example/library/golang:1.24.10-bookworm
# GOPHERLEARN_NODE_IMAGE=mirror.example/library/node:22-bookworm-slim
# GOPHERLEARN_NGINX_IMAGE=mirror.example/library/nginx:1.27-alpine
