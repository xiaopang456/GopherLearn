# syntax=docker/dockerfile:1

# Both ARGs are declared before the first FROM: an arg consumed by a FROM must be in global
# scope, and re-declaring it inside a stage is what stage-scoped ARGs are for - copying a
# value forward, not naming a base image. Declaring NGINX_IMAGE only above its own FROM makes
# the second stage resolve to an empty base name and the build fails.
#
# Node 22 satisfies web/package.json's engines range (^22.22.2), and the tag is a fixed
# series rather than `latest`. Both base images can be repointed by build arg for a mirrored
# network; the defaults are the canonical upstream names.
ARG NODE_IMAGE=node:22-bookworm-slim
ARG NGINX_IMAGE=nginx:1.27-alpine
FROM ${NODE_IMAGE} AS build

WORKDIR /web

# Dependencies resolve from the lockfile, and the npm cache is a build cache rather than a
# layer, so neither node_modules nor the cache ends up in any image that ships.
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/npm-cache npm ci --cache /npm-cache --no-audit --no-fund

# Only then the sources. Tests, config and README are read to produce dist/ and are not
# copied forward.
COPY web/ ./
RUN npm run build

# Runtime stage: the lightest thing here that can serve files and proxy. node_modules, the
# Vite sources, the test suite and the build toolchain all stay behind in `build`.
FROM ${NGINX_IMAGE} AS runtime

# Vite emits no source maps for this project (no `build.sourcemap` in vite.config.js), and
# the config's `try_files ... =404` for /assets/ means a stale hashed file is a 404 rather
# than an index.html served with the wrong content type.
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html

EXPOSE 8080
