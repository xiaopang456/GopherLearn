# Copy to `.env` (git-ignored) and adjust per environment.
# Origin of the GopherLearn HTTP/SSE API. Leave empty to call the same origin
# the page is served from — that is the normal local setup, because `vite dev`
# proxies `/api` to the Go server for you.
VITE_API_BASE_URL=

# Display name shown in the shell header.
VITE_APP_TITLE=GopherLearn

# Dev-server only: where `vite dev` forwards `/api`. Read by vite.config.js,
# never shipped to the browser. Defaults to the backend's loopback address.
VITE_DEV_API_ORIGIN=http://127.0.0.1:8080

# Dev-server only: the transport behind the long-term memory screen.
#
# Default `off` — the memory page talks to the real Go backend through the proxy
# configured above (`VITE_DEV_API_ORIGIN`), exactly like sessions and knowledge.
# Any other value except the exact word `on` behaves like `off`, and a production
# build always uses the real backend no matter what is set here.
#
# `VITE_MEMORY_MOCK=on` installs the bundled demo adapter under the dev server,
# for looking at the confirmation flow without seeding an account. Those rows are
# invented data, so the page keeps saying so: the header badge reads 演示数据 and
# a notice states they are not this account's real memories.
#
# Automated tests do not read this flag; they inject their own adapter through
# `setMemoryAdapter(createMockMemoryAdapter())`.
VITE_MEMORY_MOCK=off
